{
  "expo": {
    "name": "Platform Blocks Native",
    "slug": "platform-blocks-native",
    "version": "1.0.0",
    "scheme": "platformblocksnative",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-audio"
    ],
    "platforms": [
      "ios",
      "android"
    ]
  }
}