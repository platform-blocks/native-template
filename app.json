{
  "expo": {
    "name": "plocks Native",
    "slug": "plocks-native",
    "version": "0.1.0",
    "scheme": "plocksnative",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-audio"
    ],
    "platforms": [
      "ios",
      "android"
    ]
  }
}